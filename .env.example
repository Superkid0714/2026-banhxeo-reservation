PORT=3000
HOST=127.0.0.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deploying
BANK_NAME=토스뱅크
BANK_ACCOUNT=1002-7788-0098
BANK_ACCOUNT_HOLDER=이요셉
RESERVATION_UNIT_PRICE=5500
MAX_ORDER_QUANTITY=5
PAYMENT_TIMEOUT_MINUTES=1440
# 한국 시간 10월 5일 23:59 이후 신규 사전예약 접수를 닫습니다.
PREORDER_CLOSE_AT=2026-10-06T00:00:00+09:00
# 개발 모드에서는 실제 문자를 보내지 않습니다.
SMS_MODE=mock
# 실제 SOLAPI 발송: SMS_MODE=solapi. API 키·시크릿과 승인된 발신번호를 설정하세요.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# SOLAPI 사진문자는 콘솔에 업로드한 MMS JPG의 이미지 ID를 설정하면 사용합니다.
SOLAPI_IMAGE_ID=
# 실제 센드온 발송: SMS_MODE=sendon. 사업자 인증·API 키·발신번호 승인과 허용 IP 등록이 필요합니다.
SENDON_USER_ID=
SENDON_API_KEY=
SENDON_SENDER=
# 실제 알리고 발송: SMS_MODE=aligo. 등록·승인된 발신번호를 숫자만 입력하세요.
ALIGO_USER_ID=
ALIGO_API_KEY=
ALIGO_SENDER=
# 개발 환경에서만 Y 사용 가능. 실제 발송과 과금 없이 접수 API를 시험합니다.
ALIGO_TEST_MODE=N
# SMS_MODE=webhook: 서버 어댑터 URL. JSON {phone,message,idempotencyKey}
# 응답은 {"success":true} 또는 {"success":false,"error":"..."}
SMS_WEBHOOK_URL=
SMS_API_KEY=
# production은 강한 관리자 비밀번호와 실제 문자 업체 또는 웹훅 설정을 요구합니다.
NODE_ENV=development
